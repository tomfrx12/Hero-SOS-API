FRONT_DOMAIN="heros-sos.fr"
API_DOMAIN="api.heros-sos.fr"

# À relever sur le serveur, dans la configuration de Traefik
TRAEFIK_NETWORK="traefik"
TRAEFIK_ENTRYPOINT="websecure"
TRAEFIK_CERTRESOLVER="letsencrypt"

# Mot de passe sans caractères spéciaux, il est inséré dans l'URL de connexion
# Générer avec : openssl rand -hex 32
POSTGRES_USER="hero_sos"
POSTGRES_PASSWORD="change_moi"
POSTGRES_DB="hero_sos"

# Générer avec : openssl rand -hex 64
JWT_SECRET="change_moi"

SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER=""       # Email du compte Brevo (ex: contact@hero-sos.fr)
SMTP_PASSWORD=""   # Clé SMTP : Brevo > SMTP & API > Clés SMTP > Générer

# Bearer token TMDB (Read Access Token) : https://www.themoviedb.org/settings/api
TMDB_API_TOKEN="change_moi"
